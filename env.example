# Server Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your-session-secret-change-in-production-min-32-chars

# Admin User (created on seed)
ADMIN_EMAIL=admin@benefitpulse.gr
ADMIN_PASSWORD=change-me-in-production

# AI Extractor (stub - replace with real LLM API later)
# For OpenAI: https://api.openai.com/v1/chat/completions
# For custom service: http://your-ml-service.com/extract
AI_EXTRACTOR_URL=http://localhost:8000/extract
AI_EXTRACTOR_API_KEY=

# Groq API (for Chatbot)
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here

# AI Chatbot Configuration
# The chatbot uses Groq (Llama 3) for LLM-based responses
# Set GROQ_API_KEY above to enable the chatbot
# Model: llama-3.3-70b-versatile (default, can be changed via CHATBOT_MODEL)
CHATBOT_MODEL=llama-3.3-70b-versatile

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Analytics Retention (days)
ANALYTICS_RETENTION_DAYS=90

# Email Configuration (for contact form responses)
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-benefitPulse@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=benefitPulse@gmail.com
EMAIL_FROM_NAME=BenefitPulse
