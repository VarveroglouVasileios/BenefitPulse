{
  "name": "benefitpulse-backend",
  "version": "1.0.0",
  "description": "BenefitPulse Backend API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "dev:worker": "NODE_ENV=development npm run worker",
    "trigger": "ts-node src/scripts/run-ingestion-once.ts",
    "cli": "ts-node src/cli.ts",
    "seed": "npm run cli seed",
    "migrate:user-profiles": "npm run cli migrate:profiles",
    "vapid-keys": "npm exec -- web-push generate-vapid-keys",
    "cleanup": "ts-node src/scripts/cleanup-opportunities.ts",
    "dedup:opportunities": "ts-node src/scripts/dedup-opportunities.ts",
    "backfill:embeddings": "ts-node src/scripts/backfill-opportunity-embeddings.ts",
    "test:lifecycle": "npm run build && node dist/utils/lifecycle-regression-smoke-test.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@sentry/node": "^10.34.0",
    "@sentry/tracing": "^7.120.4",
    "@types/nodemailer": "^7.0.4",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.3.0",
    "cheerio": "^1.0.0-rc.12",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fast-xml-parser": "^4.3.6",
    "fetch-blob": "^3.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "nodemailer": "^7.0.11",
    "pdf-parse": "^1.1.1",
    "rss-parser": "^3.13.0",
    "web-push": "^3.6.7",
    "web-streams-polyfill": "^4.0.0-beta.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/web-push": "^3.6.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
